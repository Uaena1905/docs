{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "UgameDeal",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 650
    },
    "body": {
      "family": "Inter"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B1220"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "zh-CN",
        "default": true,
        "pages": [
          {
            "group": "快速开始",
            "pages": [
              "index",
              "config"
            ]
          },
          {
            "group": "代付接口",
            "pages": [
              "payout/apply",
              "payout/async-callback",
              "payout/order-query"
            ]
          },
          {
            "group": "支付方式",
            "pages": [
              "payout/methods/global",
              "payout/methods/korea",
              "payout/methods/vietnam",
              "payout/methods/indonesia",
              "payout/methods/malaysia",
              "payout/methods/pakistan",
              "payout/methods/egypt",
              "payout/methods/thailand",
              "payout/methods/philippines"
            ]
          },
          {
            "group": "产品介绍",
            "pages": [
              "payout/intro"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/ugamedeal-logo.png",
    "dark": "/logo/ugamedeal-logo.png",
    "href": "/"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "#",
      "github": "#",
      "linkedin": "#"
    }
  }
}
